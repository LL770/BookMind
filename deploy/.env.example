# ============================================
# BookMind 环境变量模板
# 复制为 .env 并填入实际值，不要提交到 Git
# cp .env.example .env && vim .env
# ============================================

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=bookmind
DB_PASSWORD=请修改为强密码

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=请修改为强密码

# ===== RabbitMQ =====
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USERNAME=bookmind
RABBIT_PASSWORD=请修改为强密码

# ===== MinIO =====
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=bookmind_admin
MINIO_SECRET_KEY=请修改为强密码
MINIO_BUCKET=book-files

# ===== JWT =====
# 生成: openssl rand -base64 48
JWT_SECRET=请替换为随机字符串
JWT_EXPIRATION=86400

# ===== AI Provider (sensenova / siliconflow) =====
AI_PROVIDER=sensenova

# ===== SenseNova =====
SENSENOVA_API_KEY=sk-你的sensenova密钥
SENSENOVA_API_KEY_KG=sk-你的kg密钥

# ===== SiliconFlow =====
SILICONFLOW_KEY_CHAT=sk-你的硅基流动密钥
SILICONFLOW_KEY_EMBED=sk-你的embed密钥
SILICONFLOW_KEY_SPECIAL=sk-你的special密钥

# ===== Qdrant =====
QDRANT_HOST=localhost
QDRANT_PORT=6334

# ===== 限流 =====
RATE_LIMIT_CHAT=60
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_SEARCH=100
